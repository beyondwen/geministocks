# ============================================
# Gemini Stocks - 环境变量配置模板
# ============================================
# 复制此文件为 .env.local 并填写实际值
# cp .env.example .env.local
# ============================================

# --------------------------------------------
# AI API 配置 (必需)
# --------------------------------------------
# OpenRouter API Key - 用于 AI 分析功能
# 获取地址: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# --------------------------------------------
# 数据库配置 (必需 - Neon PostgreSQL)
# --------------------------------------------
# Neon 数据库连接字符串
# 格式: postgresql://username:password@host/database?sslmode=require
# 获取地址: https://console.neon.tech/
DATABASE_URL=

# --------------------------------------------
# Google OAuth 配置 (可选 - 启用 Google 登录)
# --------------------------------------------
# Google OAuth 客户端 ID
# 获取地址: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Google OAuth 重定向 URI
# 本地开发: http://localhost:5173/auth/google/callback
# 生产环境: https://your-domain.com/auth/google/callback
VITE_GOOGLE_REDIRECT_URI=

# --------------------------------------------
# 监控和分析 (可选 - 推荐生产环境启用)
# --------------------------------------------
# Sentry DSN - 错误追踪
# 获取地址: https://sentry.io/
VITE_SENTRY_DSN=

# Sentry 环境标识
VITE_SENTRY_ENVIRONMENT=production

# 性能采样率 (0.0 - 1.0)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------------------------------
# 应用配置 (可选)
# --------------------------------------------
# 应用名称
VITE_APP_NAME=Gemini Stocks

# 应用版本 (自动从 package.json 读取)
VITE_APP_VERSION=

# 应用 URL (用于 SEO 和 OAuth 回调)
VITE_APP_URL=https://your-domain.com

# --------------------------------------------
# 调试配置 (仅开发环境)
# --------------------------------------------
# 启用调试模式 (true/false)
VITE_DEBUG_MODE=false

# 启用性能分析
VITE_ENABLE_PROFILING=false

# 日志级别 (debug/info/warn/error)
VITE_LOG_LEVEL=info

# --------------------------------------------
# 安全配置 (生产环境必需)
# --------------------------------------------
# 会话密钥 (用于加密)
# 生成命令: openssl rand -hex 32
SESSION_SECRET=

# CORS 允许的来源 (逗号分隔)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --------------------------------------------
# 功能开关 (可选)
# --------------------------------------------
# 启用 Google 登录
VITE_ENABLE_GOOGLE_AUTH=true

# 启用邮箱登录
VITE_ENABLE_EMAIL_AUTH=true

# 启用用户注册
VITE_ENABLE_REGISTRATION=true

# 新用户初始积分
VITE_INITIAL_CREDITS=10

# Google 登录额外奖励积分
VITE_GOOGLE_BONUS_CREDITS=5

# --------------------------------------------
# 限流配置 (可选)
# --------------------------------------------
# API 请求限制 (每分钟)
VITE_RATE_LIMIT_PER_MINUTE=60

# 分析请求限制 (每小时)
VITE_ANALYSIS_LIMIT_PER_HOUR=20

# --------------------------------------------
# 缓存配置 (可选)
# --------------------------------------------
# 分析结果缓存时间 (秒)
VITE_CACHE_TTL_SECONDS=3600

# 启用本地缓存
VITE_ENABLE_LOCAL_CACHE=true
