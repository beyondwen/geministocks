# ============================================================
# Super Digger (挖掘机) — Environment Variables
#
# ALL variables below are OPTIONAL. The app is designed to run
# with ZERO environment variables: users bring their own model
# API keys via the in-app settings (stored in browser localStorage
# only, never uploaded to any server).
#
# Copy this file to `.env.local` for local development.
# ============================================================

# ---- Serverless API fallback (api/ai-analyze.ts) ------------
# Only needed if you want the optional server-side analysis
# endpoint to work. The main app does NOT depend on it.
OPENROUTER_API_KEY=

# ---- Usage stats (api/stats.ts, optional) -------------------
# Upstash/Vercel KV REST credentials. Without them the stats
# endpoint is disabled gracefully.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Error monitoring (optional) ----------------------------
# Sentry DSN for the frontend. Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=
VITE_DEBUG_MODE=false
